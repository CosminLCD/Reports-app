# AI Provider — pune DOAR una din cele două chei (Gemini are prioritate dacă ambele sunt prezente)
#GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-api03-...

# Airtable — baza de rapoarte (destinație)
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_TABLE_NAME=Website Reports
# AIRTABLE_TABLE_ID=tbl...   # ID-ul tabelului (opțional)

# ImgBB — pentru atașarea imaginilor în Airtable (câmpul Image Element)
# Obții cheia gratuit la: https://api.imgbb.com/
IMGBB_API_KEY=

# Airtable — baza sursă de clienți/pagini
AIRTABLE_SOURCE_BASE_ID=app...
AIRTABLE_SOURCE_TABLE_NAME=Website Pages
# Airtable — numele exacte ale câmpurilor din tabelul de rapoarte
# Modifică valorile să corespundă cu denumirile din baza ta Airtable
# Airtable — numele exacte ale câmpurilor (modifică să corespundă cu baza ta)
AIRTABLE_FIELD_CLIENT=Client
AIRTABLE_FIELD_PAGE_NAME=Page Name
AIRTABLE_FIELD_PAGE_LINK=Page Link
AIRTABLE_FIELD_APP_NAME=App/Website Name
AIRTABLE_FIELD_DEVICE=Device
AIRTABLE_FIELD_OS=Operating system
AIRTABLE_FIELD_BROWSER=Browser
AIRTABLE_FIELD_PROBLEM=Problem
AIRTABLE_FIELD_SHORT_DESC=Short Description
AIRTABLE_FIELD_SOLUTION=Solution
AIRTABLE_FIELD_TECH_SOLUTION=Tehnical solution
AIRTABLE_FIELD_WCAG=WCAG
AIRTABLE_FIELD_WCAG_CATEGORY=WCAG Category
AIRTABLE_FIELD_WCAG_LEVEL=WCAG Level
AIRTABLE_FIELD_DISABILITY=Disability
AIRTABLE_FIELD_TEAM=Team of Interest
AIRTABLE_FIELD_PRIORITIZATION=Prioritization
AIRTABLE_FIELD_COMPLEXITY=Level of complexity
AIRTABLE_FIELD_IMAGE_ELEMENT=Image Element
# AIRTABLE_FIELD_IMAGE_ELEMENT_ID=fld...   # dacă vrei să omiți auto-discover (mai rapid)